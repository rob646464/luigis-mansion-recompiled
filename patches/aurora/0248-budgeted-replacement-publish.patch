 /// Returns nullopt if the filename is invalid.
 std::optional<TextureSourceKey> parse_replacement_filename(std::string_view filename) noexcept;
 
+/// Publishing decoded replacements (LM 0248). Each one is uploaded at the end of a frame, on the
+/// presenting thread, within a per-frame byte budget (gx::texture::ReplacementPublishBudgetBytes):
+/// one too large for a frame is written a row range at a time over the following frames, and the
+/// game's own texture is drawn until the last range lands, as for a replacement still loading.
+/// Counters are cumulative since start; the worstFrame values cover the frames since the previous
+/// call, so a caller that reports every few seconds sees that interval only.
+struct TexturePublishStats {
+  uint64_t completed = 0;        // replacements whose last row range was written
+  uint64_t publishedBytes = 0;   // bytes uploaded for replacements
+  uint64_t deferredFrames = 0;   // frames that ended with publishing still to do
+  uint64_t evictions = 0;        // replacements released by set_replacement_cache_budget
+  uint64_t queued = 0;           // replacements decoded and waiting for the budget
+  uint64_t inFlightBytes = 0;    // bytes still to write for the replacement being published
+  uint64_t worstFrameBytes = 0;  // worst single frame's publishing since the previous call
+  uint64_t worstFrameMicros = 0; // time that publishing took on the presenting thread
+  uint64_t budgetBytes = 0;      // the per-frame publish budget
+};
+TexturePublishStats texture_publish_stats();
+
