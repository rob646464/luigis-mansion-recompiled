@@ -170,6 +171,9 @@
                                 "(= {:.0f}% of wall time), span {:.3f} ms/frame",
                                 g_frames, secs, double(g_frames) / secs, g_busyNs * perFrame,
                                 100.0 * g_busyNs * 1e-9 / secs, g_spanNs * perFrame);
+  out += fmt::format(", passes/frame {:.1f}, commands/frame {:.0f}, draws/frame {:.0f}",
+                     double(g_passes) / double(g_frames), double(g_commands) / double(g_frames),
+                     double(g_draws) / double(g_frames));
   for (const auto& r : rows) {
     out += "\n  ";
     out += r.second;
@@ -186,6 +190,7 @@
   Log.info("{}", out);
   g_byGroup.clear();
   g_byLabel.clear();
+  g_passes = g_commands = g_draws = 0;
   g_busyNs = 0;
   g_spanNs = 0;
