+// 0240: the tail of find_pipeline for a canonical config: one hash feeds both the known-config
+// bookkeeping and the pipeline key.
+static PipelineRef find_canonical_gx_pipeline(const gx::PipelineConfig& config, const RenderTargetLayout& layout) {
+  const auto cacheKey = xxh3_hash(config, static_cast<HashType>(ShaderType::GX));
+  const bool isNew = remember_pipeline_config(ShaderType::GX, config, current_frame(), true, cacheKey);
+  const auto ref = resolve_pipeline(ShaderType::GX, config, layout, PipelinePriority::Normal, cacheKey);
   if (isNew) {
     // A config the precache did not know: queue the variants it leads to under the current
     // settings now (compiled while this one is), instead of one more miss for each later.
     queue_gx_variants(config, gx::g_accuracyFlags.load(std::memory_order_relaxed), enhanced::precache_bits(), nullptr);
   }
   return ref;
+}
