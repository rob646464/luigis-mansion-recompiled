+  // 0244: this used to walk all of s_textureObjectCaches every frame: 143 962 to 154 910 entries
+  // ([mem] "texture objects") at 2.3 ms of host time per presented frame on a base M1, 305 of 2442
+  // main-thread samples inside texture::end_frame after gx::fifo::drain and before gfx::finish, so
+  // nothing overlaps it. absl iterators do not survive an insert that grows the table, so each
+  // entry carries the frame its check is due instead.
+  static std::vector<u32> dueTickets;
+  dueTickets.clear();
+  dueTickets.swap(s_objectCacheSweepQueue[s_frameCount % ObjectCacheSweepRingSize]);
+  for (const u32 texObjId : dueTickets) {
+    const auto it = s_textureObjectCaches.find(texObjId);
+    if (it == s_textureObjectCaches.end()) {
+      continue; // Already gone: evict_texture_object, invalidate_replacement, a TLUT reload or clear.
+    }
+    auto& entry = it->second;
+    // A duplicate or late ticket is harmless: find + expired + re-queue is idempotent.
+    if (expired(entry.lastUsedFrame)) {
+      const CachedTextureEntry evicted = entry;
+      s_textureObjectCaches.erase(it);
+      clear_texture_dependency(texObjId, evicted);
