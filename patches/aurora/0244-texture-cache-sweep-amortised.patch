 TextureStats s_stats;
 
+// 0244: eviction tickets for s_textureObjectCaches, see sweep_object_caches: the texObjId to visit
+// at a frame, in that frame's bucket. Every entry has exactly one ticket pending, due when its idle
+// timeout first expires it (lastUsedFrame + ObjectCacheIdleFrames + 1). The ring is longer than
+// that distance, so a ticket always lands in a bucket that has not been processed yet, and
+// end_frame increments s_frameCount on the line before the sweep without an early exit, so each
+// frame's bucket is processed exactly once.
+constexpr uint32_t ObjectCacheSweepRingSize = 1024;
+constexpr uint64_t ObjectCacheSweepDeadlineFrames = texture::ObjectCacheIdleFrames + 1;
+std::array<std::vector<u32>, ObjectCacheSweepRingSize> s_objectCacheSweepQueue;
+
+// Queued where an entry is created (store_cached_texture) and when a due entry is still in use; a
+// new insert path into s_textureObjectCaches must queue here too, or that entry is never swept.
+void queue_object_cache_sweep(u32 texObjId, CachedTextureEntry& entry) {
+  entry.sweepFrame = static_cast<u32>(entry.lastUsedFrame + ObjectCacheSweepDeadlineFrames);
+  s_objectCacheSweepQueue[entry.sweepFrame % ObjectCacheSweepRingSize].push_back(texObjId);
+}
