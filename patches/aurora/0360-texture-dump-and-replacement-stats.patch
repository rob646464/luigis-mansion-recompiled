+/// Texture dumping for texture-pack makers (CF 0360). While enabled, every static GX texture the
+/// renderer loads is written once per session to `directory` as an RGBA8 PNG named the way
+/// Dolphin's "Dump Textures" names it: tex1_{w}x{h}[_m]_{texhash}[_{tluthash}]_{fmt}.png, "_m"
+/// when the texture's min filter uses mipmaps, and (with `mips`) its mip levels as
+/// "{name}_mip{N}.png". Existing files are kept. PNG encoding and file writes run on a background
+/// thread. EFB copies are never dumped. Enabling re-resolves every cached texture so the textures
+/// of the current scene are dumped at once. An empty directory disables dumping.
+void set_texture_dump(const std::filesystem::path& directory, bool enabled, bool mips = true);
+
+/// Dolphin's file name (without extension) for a source key: "tex1_{w}x{h}[_m]_{hash}[_{tlut}]_{fmt}".
+std::string dolphin_texture_name(const TextureSourceKey& key, bool mipmapped);
+
+/// Logs (info) the first use of every replacement: its file and the key it replaced.
+void set_replacement_log(bool enabled);
+
+/// Replacement GPU cache budget in bytes (least recently used replacements beyond it are
+/// released and streamed in again when drawn). Default 4 GiB.
+void set_replacement_cache_budget(uint64_t bytes);
+
+struct ReplacementStats {
+  uint64_t registrations = 0;    // source-key replacement files/raw entries registered
+  uint64_t cachedTextures = 0;   // replacements resident on the GPU
+  uint64_t cachedBytes = 0;      // their estimated GPU bytes
+  uint64_t budgetBytes = 0;      // set_replacement_cache_budget
+  uint64_t pendingLoads = 0;     // full-resolution loads queued or decoding
+  uint64_t hits = 0;             // texture loads resolved to a replacement texture (since start)
+  uint64_t failed = 0;           // replacement files that failed to load
+  uint64_t dumped = 0;           // textures written by the dumper this session
+  uint64_t dumpSkipped = 0;      // dump names that already existed on disk
+  uint64_t dumpQueued = 0;       // waiting for the dump thread
+};
+ReplacementStats replacement_stats();
+
 } // namespace aurora::texture
 
