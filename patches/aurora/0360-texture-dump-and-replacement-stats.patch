+// ---- Texture dumping (CF 0360) ----------------------------------------------------------------
+// Dolphin-compatible dumps for pack makers: decode on the calling (render) thread while the
+// texture's memory is what was drawn, encode + write on one background thread.
+struct DumpJob {
+  std::filesystem::path path;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  ByteBuffer pixels;
+};
+
+std::mutex s_dumpMutex;
+std::condition_variable s_dumpCv;
+std::condition_variable s_dumpRoomCv;
+std::deque<DumpJob> s_dumpJobs;
+uint64_t s_dumpQueuedBytes = 0;
+constexpr uint64_t kDumpQueueMaxBytes = 128ull * 1024ull * 1024ull;
+std::atomic<bool> s_dumpEnabled = false;
+bool s_dumpMips = true;
+std::filesystem::path s_dumpDir;
+absl::flat_hash_set<std::string> s_dumpedNames;  // this session (under s_dumpMutex)
+std::atomic<uint64_t> s_dumpWritten = 0;
+std::atomic<uint64_t> s_dumpSkipped = 0;
+thread::Thread s_dumpThread;
+
+void dump_worker(std::stop_token token) {
+  std::stop_callback notifyOnStop{token, [] { s_dumpCv.notify_all(); }};
+  while (true) {
+    DumpJob job;
+    {
+      std::unique_lock lock{s_dumpMutex};
+      s_dumpCv.wait(lock, [&] { return token.stop_requested() || !s_dumpJobs.empty(); });
+      if (s_dumpJobs.empty()) {
+        return;  // stop requested and nothing left
+      }
+      job = std::move(s_dumpJobs.front());
+      s_dumpJobs.pop_front();
+    }
+    std::error_code ec;
+    if (std::filesystem::exists(job.path, ec)) {
+      s_dumpSkipped.fetch_add(1, std::memory_order_relaxed);
+    } else if (gfx::png::write_rgba8_png(job.path, job.width, job.height, {job.pixels.data(), job.pixels.size()})) {
+      s_dumpWritten.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      Log.warn("texture dump: could not write {}", io::fs_path_to_string(job.path));
+    }
+    {
+      std::lock_guard lock{s_dumpMutex};
+      s_dumpQueuedBytes -= std::min<uint64_t>(s_dumpQueuedBytes, job.pixels.size());
+    }
+    s_dumpRoomCv.notify_all();
+  }
+}
+
+void stop_dump_thread() {
+  if (s_dumpThread.joinable()) {
+    s_dumpThread.request_stop();
+    s_dumpCv.notify_all();
+    s_dumpThread.join();
+  }
+  s_dumpThread = {};
+}
+
+// Dolphin's mip test: TexMode0's mipmap filter (bits 5-6, hardware encoding) is not "none".
+bool dolphin_mipmapped(const GXTexObj_& obj) noexcept { return ((obj.mode0 >> 5) & 3u) != 0; }
+
+// Levels Dolphin gives the texture: (max_lod + 15) / 16 extra levels, limited to the chain down to 1x1.
+uint32_t dolphin_level_count(const GXTexObj_& obj) noexcept {
+  if (!dolphin_mipmapped(obj)) {
+    return 1;
+  }
+  const uint32_t raw = (((obj.mode1 >> 8) & 0xffu) + 0xf) / 0x10;
+  uint32_t log2 = 0;
+  for (uint32_t d = std::max(obj.width(), obj.height()); d > 1; d >>= 1) {
+    ++log2;
+  }
+  return std::min(log2 + 1, raw + 1);
+}
+
+void queue_dump(DumpJob job) {
+  std::unique_lock lock{s_dumpMutex};
+  // Bounded: a burst (a new scene) waits for the writer instead of holding hundreds of MB.
+  s_dumpRoomCv.wait(lock, [] { return s_dumpQueuedBytes < kDumpQueueMaxBytes || !s_dumpEnabled; });
+  s_dumpQueuedBytes += job.pixels.size();
+  s_dumpJobs.push_back(std::move(job));
+  if (!s_dumpThread.joinable()) {
+    s_dumpThread = thread::Thread{thread::Options{.name = "Aurora texture dump", .priority = thread::Priority::Low},
+                                  dump_worker};
+  }
+  lock.unlock();
+  s_dumpCv.notify_one();
+}
 } // namespace
 
+std::string dolphin_texture_name(const TextureSourceKey& key, bool mipmapped) {
+  if (key.hasTlut) {
+    return fmt::format("tex1_{}x{}{}_{:016x}_{:016x}_{}", key.width, key.height, mipmapped ? "_m" : "",
+                       key.textureHash, key.tlutHash, key.format);
+  }
+  return fmt::format("tex1_{}x{}{}_{:016x}_{}", key.width, key.height, mipmapped ? "_m" : "", key.textureHash,
+                     key.format);
+}
+
+void set_texture_dump(const std::filesystem::path& directory, bool enabled, bool mips) {
+  const bool on = enabled && !directory.empty();
+  {
+    std::lock_guard lock{s_dumpMutex};
+    if (on && directory != s_dumpDir) {
+      s_dumpedNames.clear();
+    }
+    s_dumpDir = directory;
+    s_dumpMips = mips;
+    if (on) {
+      io::create_directories(directory);
+    }
+  }
+  const bool was = s_dumpEnabled.exchange(on);
+  s_dumpRoomCv.notify_all();
+  if (on && !was) {
+    // Textures already in the texture object cache are resolved again (and so dumped).
+    gx::clear_static_texture_cache();
+    Log.info("texture dump: on, into {}", io::fs_path_to_string(directory));
+  } else if (!on && was) {
+    Log.info("texture dump: off ({} written, {} already there)", s_dumpWritten.load(), s_dumpSkipped.load());
+  }
+}
+
+void set_replacement_log(bool enabled) {
+  s_replacementLog = enabled;
+  if (enabled) {
+    std::lock_guard lk(s_registryMutex);
+    s_loggedIds.clear();
+  }
+}
+
+void set_replacement_cache_budget(uint64_t bytes) {
+  std::lock_guard lk(s_registryMutex);
+  kReplacementCacheBudgetBytes = std::max<uint64_t>(bytes, 64ull * 1024ull * 1024ull);
+  evict_replacement_cache_if_needed();
+}
+
+ReplacementStats replacement_stats() {
+  ReplacementStats stats;
+  {
+    std::lock_guard lk(s_registryMutex);
+    stats.registrations = s_sourceEntryCount;
+    stats.cachedTextures = s_cacheByKey.size();
+    stats.cachedBytes = s_replacementCacheBytes;
+    stats.budgetBytes = kReplacementCacheBudgetBytes;
+    stats.failed = s_failedIds.size();
+  }
+  stats.pendingLoads = pending_full_load_count();
+  stats.hits = s_replacementHitsTotal.load(std::memory_order_relaxed);
+  stats.dumped = s_dumpWritten.load(std::memory_order_relaxed);
+  stats.dumpSkipped = s_dumpSkipped.load(std::memory_order_relaxed);
+  {
+    std::lock_guard lock{s_dumpMutex};
+    stats.dumpQueued = s_dumpJobs.size();
+  }
+  return stats;
+}
