+bool dumping() noexcept { return s_dumpEnabled.load(std::memory_order_relaxed); }
+
+void note_texture_for_dump(const GXTexObj_& obj, const GXTlutObj_* tlut, const TextureSourceKey& sourceKey) noexcept {
+  if (!dumping() || !obj.has_data()) {
+    return;
+  }
+  const bool mipmapped = dolphin_mipmapped(obj);
+  const std::string name = dolphin_texture_name(sourceKey, mipmapped);
+  std::filesystem::path dir;
+  bool mips = true;
+  {
+    std::lock_guard lock{s_dumpMutex};
+    if (!s_dumpedNames.insert(name).second) {
+      return;
+    }
+    dir = s_dumpDir;
+    mips = s_dumpMips;
+  }
+  if (dir.empty()) {
+    return;
+  }
+
+  const uint32_t width = obj.width();
+  const uint32_t height = obj.height();
+  // Levels the texture's memory holds (what Aurora uploads) and what Dolphin would dump.
+  const uint32_t levels = std::max(1u, mips ? std::min(dolphin_level_count(obj), obj.mip_count()) : 1u);
+  const size_t texBytes = gx::texture::texture_source_size(obj.format(), width, height, levels);
+  if (texBytes == 0) {
+    return;
+  }
+  const ArrayRef texData{static_cast<const uint8_t*>(obj.data), texBytes};
+  gfx::ConvertedTexture pixels;
+  if (gx::is_palette_format(obj.format())) {
+    if (tlut == nullptr || tlut->data == nullptr) {
+      return;
+    }
+    pixels = gfx::convert_texture_palette(obj.format(), width, height, levels, texData, tlut->format, tlut->numEntries,
+                                          tlut_bytes(*tlut));
+  } else {
+    pixels = gfx::convert_texture(obj.format(), width, height, levels, texData);
+  }
+  if (pixels.data.empty() || pixels.format != wgpu::TextureFormat::RGBA8Unorm) {
+    return;
+  }
+
+  size_t offset = 0;
+  for (uint32_t level = 0; level < levels; ++level) {
+    const uint32_t w = std::max(width >> level, 1u);
+    const uint32_t h = std::max(height >> level, 1u);
+    const size_t bytes = size_t(w) * h * 4;
+    if (offset + bytes > pixels.data.size()) {
+      break;
+    }
+    DumpJob job{
+        .path = dir / (level == 0 ? name + ".png" : fmt::format("{}_mip{}.png", name, level)),
+        .width = w,
+        .height = h,
+        .pixels = ByteBuffer{bytes},
+    };
+    std::memcpy(job.pixels.data(), pixels.data.data() + offset, bytes);
+    offset += bytes;
+    queue_dump(std::move(job));
+  }
+}
